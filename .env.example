# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，禁止入库。
# 所有开关也可以按单次请求用请求头覆盖，见 README。

# --- 模拟行为开关 ---
MOCK_LATENCY_MS=0
MOCK_EMPTY=false
MOCK_RATE_LIMITED=false
MOCK_ERROR=false

# --- 开发重置 ---
DEV_RESET_ENABLED=true
DEV_ADMIN_TOKEN=dev-admin-token

# --- 鉴权与限流 ---
TOKEN_TTL_HOURS=720
RATE_LIMIT_PER_MINUTE=600

# --- 链接与跨域 ---
# 留空：内容链接按请求 Host 生成（本机 / 局域网真机都能用）
PUBLIC_BASE_URL=
# 额外的允许来源，逗号分隔；本机 localhost 与 127.0.0.1 的任意端口已默认放行
CORS_EXTRA_ORIGINS=

# --- 内容源 ---
# mock（默认，本地夹具）| pixiv（真实上游，需要网络与登录态）
CONTENT_SOURCE=mock

# --- Pixiv 适配器（凭据只在服务端；客户端永远拿不到 Cookie）---
# 浏览器登录 pixiv 后复制完整 Cookie 串；留空时核心接口仍可用但推荐流字段会缺。
PIXIV_COOKIE=
# 国内直连 pixiv 基本不可达：填本机代理，例如 http://127.0.0.1:7897
PIXIV_PROXY=
PIXIV_BASE_URL=https://www.pixiv.net
PIXIV_IMAGE_HOST=https://i.pximg.net
PIXIV_TIMEOUT_SECONDS=20
# 429/5xx 的重试次数与首次退避秒数（指数退避 + 随机抖动，不轮换账号）
PIXIV_MAX_RETRIES=3
PIXIV_RETRY_INITIAL_SECONDS=1.5
# 单页链接与榜单的缓存秒数
PIXIV_CACHE_TTL_SECONDS=3600

# --- B 站适配器（热门 / 排行榜都是公开接口，不需要登录态；Cookie 永不进客户端）---
# 视频内容源：mock（默认，本地夹具）| bilibili（真实上游）
VIDEO_SOURCE=mock
# 部分网络需要代理才能访问 api.bilibili.com；留空表示直连
BILIBILI_PROXY=
BILIBILI_BASE_URL=https://api.bilibili.com
# 只允许回源到这些封面域名，避免图片代理变成任意地址转发
BILIBILI_IMAGE_HOSTS=https://i0.hdslb.com,https://i1.hdslb.com,https://i2.hdslb.com
# 可选：风控收紧时填一份浏览器 Cookie（buvid3 等），默认留空
BILIBILI_COOKIE=
BILIBILI_TIMEOUT_SECONDS=15
# 429 / 5xx 重试与最小请求间隔（秒）：B 站风控对密集请求敏感，实测 ranking/v2 连打会 -352
BILIBILI_MAX_RETRIES=3
BILIBILI_RETRY_INITIAL_SECONDS=1.5
BILIBILI_MIN_INTERVAL_SECONDS=0.5
# 热门页 / 分类榜缓存秒数、封面地址缓存秒数
BILIBILI_CACHE_TTL_SECONDS=600
BILIBILI_COVER_TTL_SECONDS=3600
# 质量阈值：点赞率（点赞数 / 播放数）高于它才算「高质量」
BILIBILI_LIKE_RATE_THRESHOLD=0.1

# --- 音乐页（上游是仓库同级的 multiPlatformMusicApi Node 服务）---
# mock（默认，本地夹具）| node（真实上游）
MUSIC_SOURCE=mock
# Node 服务地址；端口用低频区间，避开常被占用的 3000
MUSIC_API_BASE=http://127.0.0.1:19531
# 音乐平台：netease（默认）/ qqmusic
MUSIC_DEFAULT_PLATFORM=netease
# 默认请求最高音质（jymaster/hires/lossless/exhigh/standard）。
# 注意：上游未登录时 music.163.com 会忽略 level 参数，统一返回 128kbps mp3，
# 响应里的 effective_level 与 is_trial 反映真实结果。
MUSIC_DEFAULT_LEVEL=exhigh
MUSIC_TIMEOUT_SECONDS=15
MUSIC_MAX_RETRIES=2
MUSIC_RETRY_INITIAL_SECONDS=1.0
# 歌曲详情 / 歌词 / 评论的进程内缓存秒数
MUSIC_CACHE_TTL_SECONDS=1800
# 音频与封面只允许回源到这些域名后缀（按后缀匹配，覆盖 m701/m702...music.126.net）
MUSIC_MEDIA_HOSTS=music.126.net,music.163.com,stream.qqmusic.qq.com,aqqqmusic.tc.qq.com,gtimg.cn

# --- 宠物对话的 LLM（OpenAI 兼容；默认节点是 DeepSeek）---
# 留空 LLM_API_KEY 即视为未启用：宠物对话自动回落到规则引擎，功能不中断。
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_RETRY_INITIAL_SECONDS=1.0
