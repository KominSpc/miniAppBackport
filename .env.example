# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，禁止入库。
# 所有开关也可以按单次请求用请求头覆盖，见 README。

# --- 模拟行为开关 ---
MOCK_LATENCY_MS=0
MOCK_EMPTY=false
MOCK_RATE_LIMITED=false
MOCK_ERROR=false

# --- 开发重置 ---
DEV_RESET_ENABLED=true
DEV_ADMIN_TOKEN=dev-admin-token

# --- 鉴权与限流 ---
TOKEN_TTL_HOURS=720
RATE_LIMIT_PER_MINUTE=600

# --- 链接与跨域 ---
# 留空：内容链接按请求 Host 生成（本机 / 局域网真机都能用）
PUBLIC_BASE_URL=
# 额外的允许来源，逗号分隔；本机 localhost 与 127.0.0.1 的任意端口已默认放行
CORS_EXTRA_ORIGINS=

# --- 第三方凭据（仅服务端，禁止入库）---
PIXIV_COOKIE=
