[
  {
    "id": "fact_0001",
    "content": "「作画监督」负责统一单集内的角色与画面风格，是动画制作的关键岗位。",
    "tags": [
      "动画",
      "制作"
    ],
    "source_url": null
  },
  {
    "id": "fact_0002",
    "content": "日式 TV 动画常见的规格是每季 12～13 集，两季合并播出称为「分割两季」。",
    "tags": [
      "动画",
      "常识"
    ],
    "source_url": null
  },
  {
    "id": "fact_0003",
    "content": "「OAD」指随漫画单行本同捆发售的原创动画，通常不单独上电视播出。",
    "tags": [
      "动画",
      "常识"
    ],
    "source_url": null
  },
  {
    "id": "fact_0004",
    "content": "「WEB 动画」指以网络为主要发布渠道的动画短片，单集时长通常更短。",
    "tags": [
      "动画",
      "常识"
    ],
    "source_url": null
  },
  {
    "id": "fact_0005",
    "content": "日语「声優」在中文里写作「声优」，指以配音为主要工作的演员。",
    "tags": [
      "声优",
      "常识"
    ],
    "source_url": null
  },
  {
    "id": "fact_0006",
    "content": "「三话定律」指观众常在第 3 集判断一部作品是否值得继续追。",
    "tags": [
